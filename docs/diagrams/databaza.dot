digraph ER {
  rankdir=TB; nodesep=1.0; ranksep=0.9;
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#33475b", arrowhead=none];
  user [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
   <tr><td bgcolor="#33475b" colspan="2"><font color="white"><b>accounts_user</b></font></td></tr>
   <tr><td align="left"><b>id</b></td><td align="left">PK</td></tr>
   <tr><td align="left">username</td><td align="left">UNIQUE, NOT NULL</td></tr>
   <tr><td align="left">email</td><td align="left">UNIQUE, NOT NULL</td></tr>
   <tr><td align="left">password</td><td align="left">hash PBKDF2</td></tr>
   <tr><td align="left">first_name, last_name</td><td align="left"></td></tr>
   <tr><td align="left">phone</td><td align="left"></td></tr>
   <tr><td align="left">role</td><td align="left">ADMIN | COURIER</td></tr>
   <tr><td align="left">is_active</td><td align="left">DEFAULT true</td></tr></table>>];
  token [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
   <tr><td bgcolor="#2a9d8f" colspan="2"><font color="white"><b>authtoken_token  (I RI)</b></font></td></tr>
   <tr><td align="left"><b>key</b></td><td align="left">PK (40 karaktere)</td></tr>
   <tr><td align="left">user_id</td><td align="left">FK → user.id, UNIQUE</td></tr>
   <tr><td align="left">created</td><td align="left">datetime</td></tr></table>>];
  ship [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
   <tr><td bgcolor="#33475b" colspan="2"><font color="white"><b>shipments_shipment</b></font></td></tr>
   <tr><td align="left"><b>id</b></td><td align="left">PK</td></tr>
   <tr><td align="left">tracking_code</td><td align="left">UNIQUE, INDEX, i rastesishem</td></tr>
   <tr><td align="left">sender_name, sender_phone</td><td align="left">NOT NULL</td></tr>
   <tr><td align="left">receiver_name, receiver_phone</td><td align="left">NOT NULL</td></tr>
   <tr><td align="left">pickup_address</td><td align="left">NOT NULL</td></tr>
   <tr><td align="left">delivery_address</td><td align="left">NOT NULL</td></tr>
   <tr><td align="left">city</td><td align="left">NOT NULL, INDEX</td></tr>
   <tr><td align="left">weight_kg</td><td align="left">DECIMAL(6,2) ≥ 0.01</td></tr>
   <tr><td align="left">price</td><td align="left">DECIMAL(8,2) ≥ 0</td></tr>
   <tr><td align="left">status</td><td align="left">DEFAULT CREATED, INDEX</td></tr>
   <tr><td align="left">courier_id</td><td align="left">FK → user.id, NULL, SET NULL</td></tr>
   <tr><td align="left">created_by_id</td><td align="left">FK → user.id, PROTECT</td></tr>
   <tr><td align="left">created_at, updated_at</td><td align="left">automatike</td></tr></table>>];
  hist [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
   <tr><td bgcolor="#33475b" colspan="2"><font color="white"><b>shipments_statushistory</b></font></td></tr>
   <tr><td align="left"><b>id</b></td><td align="left">PK</td></tr>
   <tr><td align="left">shipment_id</td><td align="left">FK → shipment.id, CASCADE</td></tr>
   <tr><td align="left">status</td><td align="left">NOT NULL</td></tr>
   <tr><td align="left">note</td><td align="left">e detyrueshme per FAILED</td></tr>
   <tr><td align="left">changed_by_id</td><td align="left">FK → user.id, SET NULL</td></tr>
   <tr><td align="left">changed_at</td><td align="left">automatike</td></tr></table>>];
  {rank=same; token; user;}
  {rank=same; ship; hist;}
  token -> user [label="1 : 1", headlabel="1", taillabel="1"];
  user -> ship [label="1 korrier : N dergesa\n1 admin krijon : N dergesa", headlabel="N", taillabel="1"];
  ship -> hist [label="1 dergese : N ndryshime statusi", headlabel="N", taillabel="1"];
  user -> hist [label="1 : N (kush e ndryshoi)", headlabel="N", taillabel="1", style=dashed];
}

digraph ER {
  rankdir=LR; nodesep=0.8; ranksep=1.3;
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#33475b", arrowhead=none];
  user [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
   <tr><td bgcolor="#33475b" colspan="2"><font color="white"><b>USER</b></font></td></tr>
   <tr><td align="left"><b>id</b></td><td align="left">PK</td></tr>
   <tr><td align="left">username</td><td align="left">UNIQUE, NOT NULL</td></tr>
   <tr><td align="left">email</td><td align="left">UNIQUE, NOT NULL</td></tr>
   <tr><td align="left">password</td><td align="left">hash, NOT NULL</td></tr>
   <tr><td align="left">first_name, last_name</td><td align="left"></td></tr>
   <tr><td align="left">phone</td><td align="left"></td></tr>
   <tr><td align="left">role</td><td align="left">ADMIN | COURIER</td></tr>
   <tr><td align="left">is_active</td><td align="left">DEFAULT true</td></tr></table>>];
  ship [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
   <tr><td bgcolor="#33475b" colspan="2"><font color="white"><b>SHIPMENT (Dergesa)</b></font></td></tr>
   <tr><td align="left"><b>id</b></td><td align="left">PK</td></tr>
   <tr><td align="left">tracking_code</td><td align="left">UNIQUE, NOT NULL</td></tr>
   <tr><td align="left">sender_name, sender_phone</td><td align="left">NOT NULL</td></tr>
   <tr><td align="left">receiver_name, receiver_phone</td><td align="left">NOT NULL</td></tr>
   <tr><td align="left">pickup_address</td><td align="left">NOT NULL</td></tr>
   <tr><td align="left">delivery_address, city</td><td align="left">NOT NULL</td></tr>
   <tr><td align="left">weight_kg</td><td align="left">&gt; 0</td></tr>
   <tr><td align="left">price</td><td align="left">&gt;= 0</td></tr>
   <tr><td align="left">status</td><td align="left">DEFAULT CREATED</td></tr>
   <tr><td align="left" port="c">courier_id</td><td align="left">FK → USER.id, NULL</td></tr>
   <tr><td align="left" port="cb">created_by</td><td align="left">FK → USER.id</td></tr>
   <tr><td align="left">created_at, updated_at</td><td align="left"></td></tr></table>>];
  hist [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
   <tr><td bgcolor="#33475b" colspan="2"><font color="white"><b>STATUS_HISTORY</b></font></td></tr>
   <tr><td align="left"><b>id</b></td><td align="left">PK</td></tr>
   <tr><td align="left">shipment_id</td><td align="left">FK → SHIPMENT.id, NOT NULL</td></tr>
   <tr><td align="left">status</td><td align="left">NOT NULL</td></tr>
   <tr><td align="left">note</td><td align="left"></td></tr>
   <tr><td align="left">changed_by</td><td align="left">FK → USER.id</td></tr>
   <tr><td align="left">changed_at</td><td align="left">DEFAULT now()</td></tr></table>>];
  user -> ship [label="1 korrier : N dergesa\n1 admin krijon : N dergesa", headlabel="N", taillabel="1"];
  ship -> hist [label="1 dergese : N ndryshime statusi", headlabel="N", taillabel="1"];
  user -> hist [label="1 : N (kush e ndryshoi)", headlabel="N", taillabel="1", style=dashed];
}
